# This repository is intentionally code-only.
# Ignore everything first, then allow only source code and build configuration.
*
!*/
!/.gitignore

# Kotlin / Java / Gradle source
!*.kt
!*.java
!*.gradle
!*.gradle.kts
!*.kts
!*.pro

# Android and build configuration expressed as XML/properties/TOML
!*.xml
!*.properties
!*.toml

# Shell and build scripts
!gradlew
!*.sh
!*.bat
!*.cmd
!*.ps1

# Local-only configuration and machine state
local.properties
**/local.properties
.idea/
.vscode/
.gradle/
.gradle-user-home/
.kotlin/
gradle/gradle-daemon-jvm.properties
**/build/
build/
captures/
.externalNativeBuild/
**/.externalNativeBuild/
.cxx/
**/.cxx/
*.iml

# Generated reports, logs, test output, and coverage
**/reports/
**/test-results/
*.log
*.hprof
*.exec
*.class
*.dex

# Binary artifacts and packaged outputs
*.jar
*.aar
*.apk
*.aab
*.apks
*.zip
*.tar
*.gz
*.7z
*.bin

