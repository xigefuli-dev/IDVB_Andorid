<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 悬浮窗叠加 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 前台服务常驻（specialUse） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 常驻通知（Android 13+ 运行时申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 开机自启恢复悬浮窗 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 电池优化白名单（国产系统保活） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".IDVBApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IDVBForAndroid">

        <activity
            android:name=".tutorial.TutorialPracticeActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 1. VIEW：匹配携带通用类型 (*/*) 且路径以后缀 .idvm 结尾的文件（解决微信/QQ等「用其他应用打开」找不到的问题） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <!-- Android 12+ (API 31+) 后缀匹配与高级正则 -->
                <data android:pathSuffix=".idvm" />
                <data android:pathSuffix=".IDVM" />
                <data android:pathAdvancedPattern=".*\\.[iI][dD][vV][mM]" />
                <!-- 兼容 Android 11 及以下多层目录与单层目录点号匹配 -->
                <data android:pathPattern=".*\\.idvm" />
                <data android:pathPattern=".*\\.IDVM" />
                <data android:pathPattern=".*\\..*\\.idvm" />
                <data android:pathPattern=".*\\..*\\.IDVM" />
                <data android:pathPattern=".*\\..*\\..*\\.idvm" />
                <data android:pathPattern=".*\\..*\\..*\\.IDVM" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.idvm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.IDVM" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.idvm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.IDVM" />
            </intent-filter>

            <!-- 2. VIEW：匹配未指定 MIME 类型（type 为空）但路径以后缀 .idvm 结尾的 content/file URI -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathSuffix=".idvm" />
                <data android:pathSuffix=".IDVM" />
                <data android:pathAdvancedPattern=".*\\.[iI][dD][vV][mM]" />
                <data android:pathPattern=".*\\.idvm" />
                <data android:pathPattern=".*\\.IDVM" />
                <data android:pathPattern=".*\\..*\\.idvm" />
                <data android:pathPattern=".*\\..*\\.IDVM" />
                <data android:pathPattern=".*\\..*\\..*\\.idvm" />
                <data android:pathPattern=".*\\..*\\..*\\.IDVM" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.idvm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.IDVM" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.idvm" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.IDVM" />
            </intent-filter>

            <!-- 3. VIEW：匹配明确二进制流/压缩包/自定义 MIME 类型的 content/file URI（不依赖 URI 路径包含后缀） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/zip-compressed" />
                <data android:mimeType="application/x-compress" />
                <data android:mimeType="application/x-compressed" />
                <data android:mimeType="application/vnd.idv.map" />
                <data android:mimeType="application/vnd.idvb.map" />
                <data android:mimeType="application/vnd.idvm" />
                <data android:mimeType="application/idvm" />
                <data android:mimeType="application/x-idvm" />
                <data android:mimeType="application/binary" />
                <data android:mimeType="application/x-binary" />
                <data android:mimeType="application/unknown" />
                <data android:mimeType="application/x-unknown" />
            </intent-filter>

            <!-- 4. SEND & SEND_MULTIPLE：接收文件管理器、聊天软件（微信/QQ）等通过“分享”传来的 IDVM 地图包 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
                <data android:mimeType="application/*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/zip-compressed" />
                <data android:mimeType="application/x-compress" />
                <data android:mimeType="application/x-compressed" />
                <data android:mimeType="application/vnd.idv.map" />
                <data android:mimeType="application/vnd.idvb.map" />
                <data android:mimeType="application/vnd.idvm" />
                <data android:mimeType="application/idvm" />
                <data android:mimeType="application/x-idvm" />
                <data android:mimeType="application/binary" />
                <data android:mimeType="application/x-binary" />
                <data android:mimeType="application/unknown" />
                <data android:mimeType="application/x-unknown" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diagnostics.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostics_file_paths" />
        </provider>

        <!-- 悬浮窗前台服务：specialUse，targetSdk 34+ 必须声明类型与子类型 -->
        <service
            android:name=".overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaProjection"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="overlay" />
        </service>

        <service
            android:name=".recognize.AccessibilityScreenCaptureService"
            android:exported="true"
            android:label="IDVB 屏幕识别"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 开机自启恢复悬浮窗 -->
        <receiver
            android:name=".keepalive.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
