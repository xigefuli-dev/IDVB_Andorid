<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Keep a standards-sized adaptive-icon canvas so OEM installers do not upscale and crop the logo. -->
    <item
        android:width="108dp"
        android:height="108dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
    <!-- Keep the supplied artwork unchanged and center it by its own canvas. -->
    <item
        android:width="72.2dp"
        android:height="72.2dp"
        android:gravity="center">
        <bitmap
            android:antialias="true"
            android:filter="true"
            android:gravity="fill"
            android:src="@drawable/idvb_logo" />
    </item>
</layer-list>
